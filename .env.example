# dapplepot_ui — Zone 5 environment variables
# Copy this file to .env before running `pnpm dev`
#
# Port allocation (platform-wide):
#   dapplepot_pipeline ingest API  → http://localhost:8000
#   dapplepot_api platform API     → http://localhost:3000
#   dapplepot_ui dev server        → http://localhost:5173

# Base URL of dapplepot_api (Zone 4).
# Vite proxies /v1/* to this URL in development, so no CORS issues.
# In production, set this to the deployed API origin.
VITE_API_BASE_URL=http://localhost:3000

# Runtime environment label — used for display in the UI env selector.
# Values: development | staging | production
VITE_APP_ENV=development
